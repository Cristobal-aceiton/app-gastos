# Copia este archivo a .env y completa con tus credenciales de Supabase
# (Project Settings -> API en tu proyecto de Supabase)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Fase 9 (pagos) — opcional, déjalo así hasta tener cuenta de Stripe.
# 'mock' (default si se omite) usa el pago simulado. 'stripe' asume que ya
# desplegaste supabase/functions/ (ver README, sección "Fase 9").
VITE_PAYMENT_PROVIDER=mock

# Opcional: URL base de tus Edge Functions de Supabase, ej.
# https://tu-proyecto.supabase.co/functions/v1
# Si la dejas vacía, se deriva automáticamente de VITE_SUPABASE_URL (mismo
# patrón en todos los proyectos de Supabase), así que normalmente no hace
# falta configurarla. Sirve tanto para Stripe (VITE_PAYMENT_PROVIDER=stripe)
# como para las Edge Functions de Premium mock de la Fase 11
# (activate-premium-mock / cancel-premium-mock), que se usan siempre.
VITE_SUPABASE_FUNCTIONS_URL=

# IMPORTANTE: la Secret Key de Stripe (la que empieza con sk_...) y el
# Webhook Signing Secret (whsec_...) NUNCA van aquí ni en ningún archivo del
# cliente. Se configuran como secrets de las Edge Functions
# (`supabase secrets set ...`), no en este .env. Ver README, sección "Fase 9".

# Fase 13.1 (notificaciones push) — clave pública VAPID, la misma que le
# pasas a `supabase secrets set VAPID_PUBLIC_KEY=...` para la Edge Function
# check-notifications. Se genera una sola vez con:
#   npx web-push generate-vapid-keys
# Esto imprime un par de claves (pública/privada): la pública va acá (es
# segura de exponer en el cliente, por diseño de Web Push), la privada NUNCA
# va en este archivo — solo como secret de la Edge Function (ver README,
# sección "Fase 13").
VITE_VAPID_PUBLIC_KEY=
